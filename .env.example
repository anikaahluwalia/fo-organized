# Copy to .env (git-ignored) and fill in. The server reads it at startup; nothing here reaches the browser.

# Claude, for reading pasted requests. Required when CLAUDE_MODE is live.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# live (default) or mock, for both integrations. Mock is always labelled in the UI and never
# stands in for a live integration that fails.
# PAPERCHASE_MODE=live
# CLAUDE_MODE=live
# FO_MODE=live

# Fo MCP endpoint. Sign-in happens in the app (Connect Fo); tokens stay in .data/.
# FO_MCP_URL=https://mcp.api.wajo.ai/fo

# PORT=8787
# APP_ORIGIN=http://localhost:8787
# DATA_DIR=.data
