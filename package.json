{
  "name": "paper-chase",
  "version": "0.1.0",
  "private": true,
  "description": "Paper Chase with Kiki + Fo: assemble rental application documents with approved outreach",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "server": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "vite build",
    "start": "vite build && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "start:mock": "vite build && KIKI_MODE=mock node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
